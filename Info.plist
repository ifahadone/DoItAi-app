<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App icon: asset-catalog AppIcon set. Declared here so the top-level CFBundleIconName key
	     is present (App Store validation requires it; the asset compiler only emits the nested one). -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Deep links (journey G15-S16): the doit:// URL scheme so widgets, notifications and shared
	     links can open an exact tab/task/capture surface. Handled by .onOpenURL in RootTabView. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.doit.DoIT</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>doit</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance: DoIT uses only standard encryption (HTTPS/ATS + Apple frameworks),
	     which is exempt, so it declares no use of non-exempt encryption. This skips the per-build
	     TestFlight/App Store encryption prompt. Revisit if the app ever adds custom cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE=YES + INFOPLIST_FILE).
	     Kept OUTSIDE App/ so the file-system-synchronized group doesn't also copy it as a resource.
	     Allows the DEBUG `-liveSync` build to reach the local http://localhost API — App Transport
	     Security otherwise blocks plaintext HTTP. NSAllowsLocalNetworking permits loopback/local hosts
	     only, so release (which talks to the API over HTTPS) is unaffected. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- EventKit free/busy overlay (P2-5) + calendar write-back (P3-7). -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DoIT shows your calendar's busy times on the day dial and can mirror your scheduled blocks back to your calendar.</string>
	<!-- CoreLocation geofenced reminders (P3-7). Region monitoring needs Always authorization. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DoIT uses your location to remind you about tasks when you arrive at or leave a place.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DoIT monitors places in the background so location reminders fire even when the app is closed.</string>
		<!-- Voice capture in Quick Add (FR-QADD-080): dictate a task with the mic + on-device speech. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>DoIT uses the microphone so you can dictate a task in Quick Add.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>DoIT transcribes your dictation into a task in Quick Add.</string>
</dict>
</plist>
